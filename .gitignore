.env
out/*
!out/.gitkeep
__pycache__/
*.pyc
.venv/
*.mp3
.claude/scheduled_tasks.lock
logs/
.run_episode.lock
.codex/runtime-bin/
# Scratch the networked agent leaves behind - it now has shell network and repo write,
# so a research turn may clone a repo into the workspace (seen: .tmp-gcc/). publish.py
# only ever `git add`s explicit paths, so these were never committable; this just keeps
# them out of `git status`. They still accumulate on disk - worth an occasional sweep.
.tmp-*/
